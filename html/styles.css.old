/* Terminal styles */
body {
    background-color: #1e1e1e;
    color: #cccccc;
    font-family: 'Courier New', monospace;
    margin: 0;
    padding: 20px;
    overflow: hidden;
}

.login-page {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: #1e1e1e;
}

.login-container {
    text-align: center;
    background-color: #252526;
    padding: 40px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
}

.login-container h1 {
    color: #569cd6;
    margin-bottom: 30px;
    font-size: 24px;
}

input, button {
    background: #3c3c3c;
    color: #cccccc;
    border: 1px solid #6c6c6c;
    padding: 12px;
    margin: 8px;
    border-radius: 4px;
    font-size: 14px;
    width: 250px;
    box-sizing: border-box;
}

input:focus {
    border-color: #007acc;
    outline: none;
}

button {
    background: #0e639c;
    color: white;
    border: none;
    cursor: pointer;
    font-weight: bold;
    margin-top: 15px;
}

button:hover {
    background: #1177bb;
}

#terminal {
    outline: none;
    white-space: pre-wrap;
    word-break: break-all;
    height: calc(100vh - 40px);
    overflow-y: auto;
    background-color: #1e1e1e;
    color: #cccccc;
    font-family: 'Courier New', monospace;
    font-size: 14px;
    line-height: 1.2;
    padding: 10px;
    box-sizing: border-box;
}

#terminal:focus {
    border-color: #007acc;
}

/* Стиль для курсора */
#terminal[contenteditable="true"]:focus {
    caret-color: #cccccc;
}

/* поддержка ANSI цветов */
.ansi-0 { color: #000; }
.ansi-1 { color: #c00; }
.ansi-32 { color: #0c0; }
.ansi-33 { color: #cc0; }
.ansi-34 { color: #00c; }
.ansi-35 { color: #c0c; }
.ansi-36 { color: #0cc; }
.ansi-37 { color: #ccc; }
