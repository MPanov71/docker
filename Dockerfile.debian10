#--- For Debian development ----
FROM debian:10

# Заменяем sources.list на архивные репозитории
RUN echo "deb http://archive.debian.org/debian buster main" > /etc/apt/sources.list && \
    echo "deb http://archive.debian.org/debian-security buster/updates main" >> /etc/apt/sources.list && \
    echo "deb http://archive.debian.org/debian buster-updates main" >> /etc/apt/sources.list

# Отключаем проверку срока действия (архивные репозитории могут иметь просроченные ключи)
RUN apt -o Acquire::Check-Valid-Until=false update && \
    apt -y upgrade && \
    apt -y install build-essential
#    apt -y install libsqlite3-dev

COPY compile.sh ./
ENTRYPOINT ["./compile.sh"]
